    {"index": 93, "name": "overload_penalty", "block": "global_cluster", "source": "node_cpus", "formula": "1.0 if any(cpu > 0.85) else 0.0", "bounds": [0.0, 1.0], "description": "Binary flag indicating if any node exceeds 85% overload ceiling"},
    {"index": 94, "name": "node_0_ram_headroom", "block": "global_cluster", "source": "node 0 ram", "formula": "(ram_total - ram_used) / ram_total", "bounds": [0.0, 1.0], "description": "Available memory headroom ratio on node slot 0"},
    {"index": 95, "name": "node_1_ram_headroom", "block": "global_cluster", "source": "node 1 ram", "formula": "(ram_total - ram_used) / ram_total", "bounds": [0.0, 1.0], "description": "Available memory headroom ratio on node slot 1"},
    {"index": 96, "name": "node_2_ram_headroom", "block": "global_cluster", "source": "node 2 ram", "formula": "(ram_total - ram_used) / ram_total", "bounds": [0.0, 1.0], "description": "Available memory headroom ratio on node slot 2"},
    {"index": 97, "name": "cluster_net_sat", "block": "global_cluster", "source": "total_rx + total_tx", "formula": "min(1.0, (total_rx + total_tx) / 300000.0)", "bounds": [0.0, 1.0], "description": "Cluster-wide network fabric saturation index"},
    {"index": 98, "name": "cluster_disk_util", "block": "global_cluster", "source": "total_disk_used / total_disk_cap", "formula": "disk_used / max(1.0, disk_total)", "bounds": [0.0, 1.0], "description": "Aggregate datastore utilization ratio"},
    {"index": 99, "name": "quorum_healthy", "block": "global_cluster", "source": "all nodes quorum", "formula": "1.0 if quorum_all else 0.0", "bounds": [0.0, 1.0], "description": "Hypervisor cluster consensus quorum status flag"},
    {"index": 100, "name": "shared_storage_ok", "block": "global_cluster", "source": "all nodes storage", "formula": "1.0 if storage_all else 0.0", "bounds": [0.0, 1.0], "description": "Shared datastore accessibility flag for live migration"},
    {"index": 101, "name": "mig_usefulness", "block": "global_cluster", "source": "node_cpus spread", "formula": "max(0.0, max(cpu) - min(cpu) - 0.15)", "bounds": [0.0, 1.0], "description": "Heuristic estimate of rebalancing dividend from migration"},
    {"index": 102, "name": "time_phase_idx", "block": "global_cluster", "source": "temporal cyclical", "formula": "(sin(t / 60.0) + 1.0) / 2.0", "bounds": [0.0, 1.0], "description": "Temporal harmonic wave providing cyclical phase context to policy"}
