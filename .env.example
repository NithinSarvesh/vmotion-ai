# ==============================================================================
# VMotion AI - Public Cloud Control Plane Environment Configuration
# ==============================================================================

# Server & Runtime Configuration
PORT=8000
MODE=virtualbox                  # Options: 'virtualbox' or 'simulation'
SERVE_FRONTEND=true              # Serves React production build alongside FastAPI
CORS_ORIGINS=["*"]               # Allowed CORS origins

# Security & Governance Credentials
GATEWAY_AGENT_TOKEN=vmotion-vbox-secret-secure-token
OPERATOR_API_KEY=vmotion-operator-key-default
ENABLE_PROXMOX_FALLBACK=false

# Cloud Agent Gateway & Heartbeat Parameters
AGENT_HEARTBEAT_TIMEOUT_SECONDS=15.0
HOST_A_ID=vbox-host-a
HOST_B_ID=vbox-host-b

# VirtualBox Live Hypervisor Defaults
VBOX_TELEPORT_PORT=60050
VBOX_DEMO_VM_NAME=DemoVM
VBOX_SHARED_STORAGE_PATH=C:\shared_vdi

# AI Reinforcement Learning Model Configuration
PPO_MODEL_PATH=models/ppo_v5_final.zip
CONFIDENCE_THRESHOLD=0.60
PROPOSAL_TTL_SECONDS=120.0
